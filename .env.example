# Google Gemini API Key (Required for AI responses)
# Free tier available from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Free Tier (Default: gemini-3.5-flash, also supports gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash

# Server Port (Default: 3000)
PORT=3000
